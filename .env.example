# Climate Chain environment variables. Names and defaults only; no secrets belong here.
# The gateway reads process environment variables; it does not load this file by itself.
# Set a variable in your shell (PowerShell: $env:NAME = 'value') before running start.ps1 or node.

# Gateway port.
PORT=8080

# Local proof chain. The gateway only writes to a loopback RPC with chain ID 31337.
CLIMATE_CHAIN_RPC_URL=http://127.0.0.1:18545

# Path overrides. Leave them empty to use the defaults below. If you set one, use an absolute
# path: the gateway does not resolve these against the repository root.
# Default: <repo>/blockchain/deployments/localhost.json (EvidenceAnchor, written by deploy.js)
CLIMATE_CHAIN_DEPLOYMENT=
# Default: <repo>/blockchain/deployments/integrity-localhost.json (evidence and claim registries)
CLIMATE_CHAIN_INTEGRITY_DEPLOYMENT=
# Where deploy.js writes both files. Default: <repo>/blockchain/deployments. Set it only to deploy
# a second test chain without overwriting the launcher's files.
CLIMATE_CHAIN_DEPLOYMENTS_DIR=
# Off-chain store for Integrity Lab bundles, raw responses, claims and challenges.
# Default: <repo>/gateway/.integrity-data
CLIMATE_CHAIN_INTEGRITY_DATA=

# Optional. Free OpenAQ v3 key for observed station data. No OpenAQ adapter ships yet,
# so this key is not used or validated by the central gateway.
OPENAQ_API_KEY=

# Development only: point the Vite dev server's /api proxy at another gateway.
CLIMATE_CHAIN_GATEWAY_URL=http://127.0.0.1:8080
