# ==============================================================================
# CLIMATE CHAIN — UNIFIED RUNTIME ENVIRONMENT CONFIGURATION
# ==============================================================================
# Canonical Single .env for the Entire IEEE Climate Chain Platform.
# No secret credentials or sensitive tokens should be committed to version control.
# Safe local defaults are configured for immediate local evaluation.
# ==============================================================================

# Core Application & Gateway Ports
PORT=8080
CLIMATE_CHAIN_PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# Local Proof-Chain (EVM Hardhat Node)
# The gateway writes strictly to a loopback RPC with Chain ID 31337. Zero speculative tokenomics.
CLIMATE_CHAIN_RPC_URL=http://127.0.0.1:18545
EVM_RPC_URL=http://127.0.0.1:18545
CHAIN_ID=31337

# Blockchain Deployment Overrides (Defaults point to canonical contract artifacts)
CLIMATE_CHAIN_DEPLOYMENT=
CLIMATE_CHAIN_INTEGRITY_DEPLOYMENT=
CLIMATE_CHAIN_DEPLOYMENTS_DIR=
CLIMATE_CHAIN_INTEGRITY_DATA=

# Frontend Configuration
VITE_API_BASE=http://127.0.0.1:8080
VITE_CESIUM_ION_TOKEN=

# Civic Connectors & Climate Data Sources (Real public endpoints & labeled fallbacks)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPENAQ_API_KEY=
NASA_API_KEY=
NOAA_API_TOKEN=

# Integrated Specialist API Endpoints (Gateway manages live proxies with labeled fallbacks)
JUNKSNAP_API_URL=https://junksnap.coehemang.dev
CLEARSKY_API_URL=https://clearsky.akkki.tech
TEESRI_SHIKAYAT_API_URL=https://eirioqqhvtvve3aw5xhpje2wju0jztrl.lambda-url.ap-south-1.on.aws
VAYU_API_URL=https://vayu.thevayuproject.org
PLUME_API_URL=https://plume.kaavin.dev
